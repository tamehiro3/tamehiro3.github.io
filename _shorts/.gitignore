# 再生成できる中間ファイル
build/
episodes/*/out/still_*.png
episodes/*/out/*.wav
episodes/*/audio/*.wav
episodes/test/
# 外部から取得するもの（tools/setup.sh が取得）
assets/fonts/*.ttf
assets/models/
# 声の素材とクローンID（個人の声なのでリポジトリに入れない）
voice_ref/*
!voice_ref/README.md
__pycache__/
# fal の APIキー（絶対にコミットしない）
assets/.fal_key
**/.fal_key
**/.fal_key.txt
# 動画・音声は各自のPCで生成する（クローン声版とぶつからないように。ep01/ep02 の既存分は履歴に残る）
episodes/ep0[3-9]/out/
episodes/ep0[3-9]/audio/
