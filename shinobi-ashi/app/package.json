{
  "name": "shinobi-ashi-app",
  "version": "0.1.0",
  "private": true,
  "description": "忍び足（しのびあし）のアプリ化（Capacitor 8）。CryptoNinja（CC0・Ninja DAO）のキャラクターを使った個人制作の非公式ファンゲームです。",
  "license": "UNLICENSED",
  "scripts": {
    "copy-web": "node scripts/copy-web.mjs",
    "sync": "node scripts/copy-web.mjs && npx cap sync",
    "sync:android": "node scripts/copy-web.mjs && npx cap sync android",
    "sync:ios": "node scripts/copy-web.mjs && npx cap sync ios",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "test": "node scripts/test-platform.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@capgo/capacitor-pedometer": "8.0.52"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
